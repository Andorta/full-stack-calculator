{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run backend",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "full-stack", "panel": "dedicated" }
    },
    {
      "label": "Run frontend",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "full-stack", "panel": "dedicated" }
    },
    {
      "label": "Run full stack",
      "dependsOn": ["Run backend", "Run frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
